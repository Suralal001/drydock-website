---
import BaseLayout from './BaseLayout.astro';
import AuthorBio from '../components/AuthorBio.astro';
import Byline from '../components/Byline.astro';
import { getEntries } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: { depth: number; slug: string; text: string }[];
  related: CollectionEntry<'blog'>[];
}

const { post, headings, related } = Astro.props;
const d = post.data;
const url = new URL(`/blog/${post.id}`, Astro.site).href;

// Resolve author references -> full author entries
const authors = await getEntries(d.authors);

const toc = headings.filter((h) => h.depth === 2);
const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const readTime = Math.max(1, Math.round(words / 225));

// ── schema.org ──
const personSchema = (a: CollectionEntry<'authors'>) => {
  const p: Record<string, unknown> = {
    '@type': 'Person',
    name: a.data.name,
    jobTitle: a.data.title,
    url: new URL(`/blog/author/${a.id}`, Astro.site).href,
  };
  const same = [a.data.linkedin, a.data.website].filter(Boolean);
  if (same.length) p.sameAs = same;
  return p;
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  author: authors.map(personSchema),
  publisher: { '@type': 'Organization', name: 'DryDock AI', url: 'https://usedrydock.com' },
  mainEntityOfPage: url,
  image: new URL(d.image, Astro.site).href,
  keywords: d.tags.join(', '),
  wordCount: words,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://usedrydock.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://usedrydock.com/blog' },
    { '@type': 'ListItem', position: 3, name: d.title, item: url },
  ],
};

const faqSchema = d.faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: d.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

const schema = [articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
---
<BaseLayout
  title={`${d.title} | DryDock AI`}
  description={d.description}
  image={d.image}
  imageAlt={d.imageAlt}
  type="article"
  schema={schema}
>
  <article>
    <div class="kicker">{d.pillar}</div>
    <h1>{d.title}</h1>

    <Byline authors={authors} pubDate={d.pubDate} updatedDate={d.updatedDate} readTime={readTime} />

    {d.answer && (
      <div class="answer">
        <div class="lbl">THE SHORT ANSWER</div>
        <p>{d.answer}</p>
      </div>
    )}

    {toc.length > 2 && (
      <nav class="toc" aria-label="Table of contents">
        <div class="lbl">ON THIS PAGE</div>
        <ol>
          {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </nav>
    )}

    <slot />

    {d.faqs.length > 0 && (
      <section class="faq">
        <h2>Frequently asked questions</h2>
        {d.faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>
    )}

    <div class="cta">
      <h2>See it on your own release process</h2>
      <p>DryDock turns the change processes you already have into workflows that run themselves and prove they ran.</p>
      <a class="btn" href="/#early-access">Request early access</a>
    </div>

    <AuthorBio authors={authors} />

    {related.length > 0 && (
      <div class="related">
        <div class="lbl">RELATED READING</div>
        <ul>
          {related.map((r) => <li><a href={`/blog/${r.id}`}>{r.data.title}</a></li>)}
        </ul>
      </div>
    )}
  </article>
</BaseLayout>
