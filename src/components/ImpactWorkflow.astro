---
import '../styles/impact-workflow.css';
---
<div class="impact-workflow">
<section class="iw-section" id="insights"><div class="iw-copy"><span class="iw-eyebrow">04 / ENGINEERING IMPACT</span><h2>Measure the work.<br/><em>Understand the tradeoffs.</em></h2><p>Governance should make delivery easier to explain. Follow review effort, release outcomes and AI spend together, with the context behind each number.</p><button class="iw-cta" id="see-impact">See the impact <span>→</span></button></div><div class="iw-analytics" id="impact-analytics" tabindex="-1" aria-label="Interactive engineering analytics"><div class="iw-kpis" role="group" aria-label="Choose an outcome metric">{[['◷','Review turnaround','6.4 h'],['◇','Release outcomes','97%'],['▥','AI tool spend','$12.4k']].map(([icon,label,value],i)=><button type="button" data-metric={i} aria-pressed={i===0}><span><i>{icon}</i>{label}</span><strong data-kpi={i}>{value}</strong><small>{['−42% review time','Stable-release rate','+28% investment'][i]}</small></button>)}</div><div class="iw-chart-head"><h3 id="impact-chart-title">Release volume and review effort</h3><div class="iw-toggle" role="group" aria-label="Comparison period"><button type="button" data-period="before" aria-pressed="false">Before AI</button><button type="button" data-period="with" aria-pressed="true">With AI</button></div></div><div class="iw-legend"><span id="bar-legend">● Releases</span><span id="line-legend">● Review time (h)</span></div><svg id="impact-chart" viewBox="0 0 680 220" role="img" aria-labelledby="impact-chart-title impact-chart-description"><desc id="impact-chart-description">Illustrative monthly release volume and review time, May through October.</desc><g stroke="#2b2435"><path d="M48 30H630M48 80H630M48 130H630M48 180H630"/></g><g class="iw-bars" fill="#65517c">{[60,65,82,95,115,120].map((v,i)=><rect data-bar={i} x={68+i*94} y={180-v} width="47" height={v} rx="4"/>)}</g><path class="iw-line" d="M91 65L185 90L279 108L373 126L467 130L561 134" fill="none" stroke="#cfafea" stroke-width="3"/><g fill="#cfafea">{[65,90,108,126,130,134].map((v,i)=><circle data-point={i} cx={91+i*94} cy={v} r="4"/>)}</g><g fill="#9786a7" font-size="11">{['May','Jun','Jul','Aug','Sep','Oct'].map((m,i)=><text x={91+i*94} y="205" text-anchor="middle">{m}</text>)}{[0,1,2,3].map((n)=><text data-axis={n} x="38" y={184-n*50} text-anchor="end">{n*50}</text>)}{[0,1,2,3].map(n=><text data-right-axis={n} x="640" y={184-n*50}>{n*4}h</text>)}</g></svg><div class="iw-insight" aria-live="polite"><strong id="impact-insight-title">Review turnaround is down 42%.</strong><p id="impact-insight-copy">Review time fell from 11.0 to 6.4 hours as release volume grew. Follow the effort behind each decision.</p></div><p class="iw-sample">Illustrative data · May–October · comparison demonstrates the product view, not measured customer results.</p></div></section>
<section class="iw-section iw-workflow" id="use-cases"><div class="iw-copy"><span class="iw-eyebrow">05 / ONE CONNECTED WORKFLOW</span><h2>Keep your tools.<br/><em>Connect the decisions.</em></h2><p>Bring repository, issue and pipeline context into the release conversation. Start with the stack you use and the decisions your team needs to govern.</p><div class="iw-questions"><a href="/blog/reviewers-are-the-bottleneck">Where is review becoming a bottleneck? <span>↗</span></a><a href="/blog/prove-your-release-process-was-followed">Can we show why this release was approved? <span>↗</span></a></div></div><div class="iw-network-card"><div class="iw-network"><svg class="iw-connections" viewBox="0 0 700 210" preserveAspectRatio="none" aria-hidden="true"><g fill="none" stroke="#473354" stroke-width="2"><path d="M130 40C245 40 200 105 350 105S455 40 570 40"/><path d="M130 105H570"/><path d="M130 170C245 170 200 105 350 105S455 170 570 170"/></g><path id="signal-flow" d="M130 105H570" fill="none" stroke="#b88ed9" stroke-width="3" pathLength="100"/></svg><div class="iw-sources">{[['github','GitHub','github'],['jira','Jira','jira'],['ci','GitHub CI','github']].map(([key,label,icon])=><button type="button" data-signal={key} aria-pressed={key==='jira'}><img src={`/${icon}.svg`} width="25" height="25" alt=""/>{label}</button>)}</div><div class="iw-hub"><img src="/drydock-logo-tile.svg" alt="DryDock" width="66" height="66"/><small>Connected evidence</small></div><div class="iw-destinations">{[['review','✓','Review & approval'],['policy','◇','Policy & exceptions'],['release','▥','Release outcome']].map(([key,icon,label])=><button type="button" data-signal={key} aria-pressed="false"><i>{icon}</i>{label}</button>)}</div></div><div class="iw-evidence" aria-live="polite"><span id="signal-kind">INTENT → DRYDOCK</span><h3 id="signal-title">Intent captured</h3><strong id="signal-record">PAY-482</strong><p id="signal-description">Update payment reconciliation rules.</p><small id="signal-context">Linked to PR #1291 and the release decision.</small></div><div class="iw-network-footer"><div><span class="iw-eyebrow">FOR ENGINEERING LEADERS AND THEIR TEAMS</span><h3>One decision. The right people.</h3><p>Engineers get review context. Leads handle policy exceptions. Security teams can follow the evidence.</p><a href="https://calendly.com/suralal-s" target="_blank" rel="noopener">Explore your workflow with us ↗</a></div><img src="/images/team.webp" alt="Engineering team discussing a release" width="200" height="130" loading="lazy"/></div></div></section>
</div>
<script>
const root=document.querySelector<HTMLElement>('.impact-workflow')!;
const $=(id:string)=>root.querySelector<HTMLElement>('#'+id)!;
let metric=0,period='with',countFrame=0;
const data=[
{title:'Release volume and review effort',bar:'Releases',line:'Review time (h)',max:150,right:12,unit:'h',withBars:[60,65,82,95,115,120],beforeBars:[45,48,53,58,65,72],withLine:[10,8.8,8,7.2,6.7,6.4],beforeLine:[11.8,11.6,11.5,11.3,11.1,11],headline:'Review turnaround is down 42%.',copy:'Review time fell from 11.0 to 6.4 hours as release volume grew. Follow the effort behind each decision.',baseline:'Before AI: 11.0-hour review turnaround.',beforeCopy:'The baseline connects review effort to release volume, before the AI-assisted workflow.'},
{title:'Release volume and stable-release rate',bar:'Releases',line:'Stable releases (%)',max:150,right:100,unit:'%',withBars:[60,65,82,95,115,120],beforeBars:[45,48,53,58,65,72],withLine:[96,97,96,98,97,97],beforeLine:[94,95,94,95,96,95],headline:'97% of releases remained stable.',copy:'Compare delivery volume with production outcomes. More output matters when release stability holds.',baseline:'Before AI: 95% stable-release rate.',beforeCopy:'Use the production baseline to understand whether faster delivery changes operational risk.'},
{title:'AI investment and assisted delivery output',bar:'AI spend ($k)',line:'AI-assisted output (index)',max:15,right:150,unit:'',withBars:[9.7,10.1,10.6,11.2,11.8,12.4],beforeBars:[9.7,9.7,9.7,9.7,9.7,9.7],withLine:[100,105,111,120,128,134],beforeLine:[100,100,100,100,100,100],headline:'AI investment is up 28%.',copy:'Delivery output increased 34%, while stable-release rate remained at 97%. Value / Cost: 2.3×.',baseline:'Baseline: $9.7k investment · output index 100.',beforeCopy:'The comparison baseline makes changes in spend and output visible. Value / cost is an illustrative estimate.'}
];
function kpis(progress=1){const values=period==='with'?[6.4,97,12.4]:[11,95,9.7];root.querySelectorAll<HTMLElement>('[data-kpi]').forEach((el,i)=>{el.textContent=i===0?(values[i]*progress).toFixed(1)+' h':i===1?Math.round(values[i]*progress)+'%':'$'+(values[i]*progress).toFixed(1)+'k';});root.querySelectorAll<HTMLElement>('.iw-kpis small').forEach((el,i)=>el.textContent=period==='with'?['−42% review time','Stable-release rate','+28% investment'][i]:['Baseline review time','Baseline stability','Baseline investment'][i]);}
function render(){cancelAnimationFrame(countFrame);const d=data[metric],bars=period==='with'?d.withBars:d.beforeBars,line=period==='with'?d.withLine:d.beforeLine;root.querySelectorAll('[data-metric]').forEach((el,i)=>el.setAttribute('aria-pressed',String(i===metric)));root.querySelectorAll<HTMLElement>('[data-period]').forEach(el=>el.setAttribute('aria-pressed',String(el.dataset.period===period)));$('impact-chart-title').textContent=d.title;$('bar-legend').textContent='● '+d.bar;$('line-legend').textContent='● '+d.line;root.querySelectorAll('[data-bar]').forEach((el,i)=>{const height=bars[i]/d.max*150;el.setAttribute('height',String(height));el.setAttribute('y',String(180-height));});const points=line.map((v,i)=>[91+i*94,180-v/d.right*150]);root.querySelector('.iw-line')!.setAttribute('d',points.map(([x,y],i)=>(i?'L':'M')+x+' '+y).join(''));root.querySelectorAll('[data-point]').forEach((el,i)=>el.setAttribute('cy',String(points[i][1])));root.querySelectorAll('[data-axis]').forEach((el,i)=>el.textContent=String(i*d.max/3));root.querySelectorAll('[data-right-axis]').forEach((el,i)=>el.textContent=String(Math.round(i*d.right/3))+d.unit);$('impact-insight-title').textContent=period==='with'?d.headline:d.baseline;$('impact-insight-copy').textContent=period==='with'?d.copy:d.beforeCopy;$('impact-chart-description').textContent=`Illustrative ${period==='with'?'with AI':'before AI'} data, May–October. ${d.bar}: ${bars.join(', ')}. ${d.line}: ${line.join(', ')}.`;kpis();}
root.querySelectorAll<HTMLButtonElement>('[data-metric]').forEach((el,i)=>el.addEventListener('click',()=>{metric=i;render();}));root.querySelectorAll<HTMLButtonElement>('[data-period]').forEach(el=>el.addEventListener('click',()=>{period=el.dataset.period!;render();}));$('see-impact').addEventListener('click',()=>{$('impact-analytics').scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'center'});$('impact-analytics').focus({preventScroll:true});});
render();const observer=new IntersectionObserver(entries=>{if(entries.some(e=>e.isIntersecting)){observer.disconnect();$('impact-analytics').classList.add('chart-entered');if(!matchMedia('(prefers-reduced-motion: reduce)').matches){const start=performance.now();function count(now:number){const p=Math.min(1,(now-start)/850);kpis(p);if(p<1)countFrame=requestAnimationFrame(count);}countFrame=requestAnimationFrame(count);}}},{threshold:.3});observer.observe($('impact-analytics'));
const signals:Record<string,string[]>={jira:['INTENT → DRYDOCK','Intent captured','PAY-482','Update payment reconciliation rules.','Linked to PR #1291 and the release decision.'],github:['CHANGE → DRYDOCK','Change captured','PR #1291','AI-assisted · 3 files changed.','The diff is linked to PAY-482, checks and policy PAY-07.'],ci:['VERIFICATION → DRYDOCK','Verification captured','41/41 checks passed','Security scan complete.','Test and security evidence are attached to the same change.'],review:['DRYDOCK → HUMAN DECISION','Review with full context','Sarah M. · Tech Lead','Intent, diff, checks and the matching policy arrive together.','The reviewer owns the decision; DryDock connects the evidence.'],policy:['DRYDOCK → POLICY & EXCEPTIONS','PAY-07 triggered','Routed to Sarah M.','Payment-related AI changes require senior review.','Passing automated checks does not remove the human approval requirement.'],release:['DRYDOCK → PRODUCTION','Release outcome connected','Release 4.2 · Stable','14 days observed · 0 linked incidents · 0 rollbacks.','Illustrative outcome linked back to the original intent and recorded approval.']};
const paths:Record<string,string>={github:'M130 40C245 40 200 105 350 105',jira:'M130 105H350',ci:'M130 170C245 170 200 105 350 105',review:'M350 105C455 105 455 40 570 40',policy:'M350 105H570',release:'M350 105C455 105 455 170 570 170'};
root.querySelectorAll<HTMLButtonElement>('[data-signal]').forEach(button=>button.addEventListener('click',()=>{const key=button.dataset.signal!;root.querySelectorAll('[data-signal]').forEach(el=>el.setAttribute('aria-pressed',String(el===button)));['signal-kind','signal-title','signal-record','signal-description','signal-context'].forEach((id,i)=>$(id).textContent=signals[key][i]);const path=$('signal-flow');path.setAttribute('d',paths[key]);if(!matchMedia('(prefers-reduced-motion: reduce)').matches){path.getAnimations().forEach(a=>a.cancel());path.animate([{strokeDashoffset:100,opacity:0},{strokeDashoffset:75,opacity:1,offset:.15},{strokeDashoffset:-100,opacity:0}],{duration:1000,easing:'ease-in-out'});}}));
</script>
