---
import Icon from './MarketingIcon.astro';
import '../styles/security-boundary.css';
const boundaries=[['lock','Repository permissions','Review which repositories and permissions your workflow needs before connecting.'],['shield','Data handling','Discuss what is accessed, where it is processed, retention and model-provider handling.'],['users','Decision ownership','Define who reviews exceptions and which decisions require human approval.'],['check','Evidence requirements','Agree which checks, approvals and records your audit process needs.']];
---
<section class="boundary-section" id="security"><div class="boundary-wrap"><div class="boundary-layout"><div class="boundary-copy"><span class="boundary-eyebrow">06 / SECURITY & CONTROL</span><h2>Start with trust.<br/><em>Agree the boundaries.</em></h2><p>Before connecting your environment, review the access, data handling and deployment requirements with our team.</p><div class="boundary-controls" role="group" aria-label="Explore security boundaries">{boundaries.map(([icon,title,desc],i)=><button type="button" data-boundary={i} aria-pressed={i===0} aria-controls="boundary-visual"><Icon name={icon} tone={['blue','green','purple','orange'][i]}/><span><strong>{title}</strong><span>{desc}</span></span><b aria-hidden="true">→</b></button>)}</div></div><div class="boundary-visual" id="boundary-visual" data-active="0"><svg class="boundary-rings" viewBox="0 0 600 600" aria-hidden="true">{[220,190,160,130].map((radius,i)=><circle class:list={['boundary-ring',{'selected':i===0}]} data-ring={i} cx="300" cy="300" r={radius} pathLength="100"/>)}{[[100,208],[500,208],[110,410],[490,410]].map(([x,y],i)=><circle class="boundary-point" cx={x} cy={y} r="5" style={`--point:${i}`}/>)}</svg><div class="boundary-shield" aria-hidden="true"><svg viewBox="0 0 240 280"><defs><linearGradient id="boundary-glass" x2="1" y2="1"><stop stop-color="#5c456eee"/><stop offset="1" stop-color="#26193299"/></linearGradient><linearGradient id="boundary-blue" x2=".8" y2="1"><stop stop-color="#b293cc"/><stop offset=".45" stop-color="#694583"/><stop offset="1" stop-color="#2e1c40"/></linearGradient></defs><path d="M120 10 226 63v73c0 62-53 104-106 135C67 240 14 198 14 136V63Z" fill="url(#boundary-glass)" stroke="white" stroke-width="2"/><path d="M120 32 207 76v58c0 53-43 88-87 115-44-27-87-62-87-115V76Z" fill="url(#boundary-blue)" stroke="#b392d0" stroke-width="2"/><path d="m120 53 68 34v47c0 43-33 71-68 94-35-23-68-51-68-94V87Z" fill="#603e8055" stroke="#d6b6ed66"/><rect x="98" y="124" width="44" height="36" rx="4" fill="none" stroke="white" stroke-width="5"/><path d="M106 123v-12a14 14 0 0 1 28 0v12m-14 16v9" fill="none" stroke="white" stroke-width="5" stroke-linecap="round"/></svg></div><div class="boundary-callouts" aria-live="polite" aria-atomic="true">{[['Repository access','Choose the repositories in scope'],['Read-only where possible','Review permissions per integration'],['Required signals only','Agree the minimum access needed'],['Access owner','Your team approves the scope']].map(([title,desc],i)=><div class={`boundary-callout point-${i}`} style={`--point:${i}`}><Icon name={['code','shield','check','users'][i]} tone={['blue','green','orange','purple'][i]}/><span><strong data-boundary-title={i}>{title}</strong><span data-boundary-desc={i}>{desc}</span></span></div>)}</div><p class="boundary-visual-label" id="boundary-label">Repository access · define scope before connecting</p></div></div><div class="boundary-banner"><div><span class="boundary-eyebrow">BUILT AROUND YOUR REQUIREMENTS</span><h3>Let’s talk about your security and deployment needs.</h3></div><a href="mailto:suralal.s@neoito.com?subject=DryDock%20security%20enquiry">Talk to our team <span>→</span></a></div></div></section>
<script>
const root=document.querySelector<HTMLElement>('.boundary-section')!;
const controls=Array.from(root.querySelectorAll<HTMLButtonElement>('[data-boundary]'));
const content=[
{label:'Repository access · define scope before connecting',items:[['Repository access','Choose the repositories in scope'],['Read-only where possible','Review permissions per integration'],['Required signals only','Agree the minimum access needed'],['Access owner','Your team approves the scope']]},
{label:'Data handling · agree the boundaries of each signal',items:[['What is accessed','Define the code and data in scope'],['Where processed','Review processing and deployment'],['Retention','Agree how long evidence is kept'],['Model-provider handling','Review providers and data terms']]},
{label:'Decision ownership · human judgment stays with your team',items:[['Exception detected','Surface the policy and its evidence'],['Named owner','Route to the accountable reviewer'],['Human approval','Your team makes the decision'],['Decision recorded','Keep the owner, rationale and time']]},
{label:'Evidence requirements · preserve the decision trail',items:[['Checks','Link test and security results'],['Approval','Record the accountable reviewer'],['Timestamp','Keep when the decision was made'],['Release record','Connect evidence to what shipped']]}
];
let selected=0;
function preview(index:number){const data=content[index];root.querySelectorAll('[data-ring]').forEach((ring,i)=>ring.classList.toggle('selected',i===index));root.querySelector<HTMLElement>('#boundary-visual')!.dataset.active=String(index);data.items.forEach(([title,desc],i)=>{root.querySelector('[data-boundary-title="'+i+'"]')!.textContent=title;root.querySelector('[data-boundary-desc="'+i+'"]')!.textContent=desc;});root.querySelector('#boundary-label')!.textContent=data.label;controls.forEach((button,i)=>button.classList.toggle('previewing',i===index));}
controls.forEach((button,i)=>{button.addEventListener('click',()=>{selected=i;controls.forEach((b,j)=>b.setAttribute('aria-pressed',String(j===i)));preview(i);});button.addEventListener('pointerenter',()=>{if(matchMedia('(hover: hover)').matches)preview(i);});button.addEventListener('pointerleave',()=>preview(selected));button.addEventListener('focus',()=>preview(i));button.addEventListener('blur',()=>preview(selected));});
preview(0);
const observer=new IntersectionObserver(entries=>{if(entries.some(entry=>entry.isIntersecting)){root.classList.add('boundary-entered');observer.disconnect();}},{threshold:.25});observer.observe(root.querySelector('.boundary-visual')!);
</script>
