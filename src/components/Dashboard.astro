---
const bars = [18,28,24,40,33,29,45,57,40,50,65,59,42,68,78,69,88,74,91,82,100,86,76,94];
---
<div class="dashboard" aria-label="Illustrative DryDock engineering insights dashboard">
 <aside class="dash-sidebar"><b>◇ <span>DryDock</span></b>{['Overview','Releases','Evidence','AI insights','Agents','Policies','Reports','Settings'].map((s,i)=><div class:list={{selected:i===3}}><span>{['◫','▣','▤','◈','✧','▥','▧','⚙'][i]}</span><span>{s}</span></div>)}</aside>
 <div class="dash-main"><div class="dash-heading"><div><h3>AI insights</h3><p>Engineering clarity. Measurable impact.</p></div><span class="dash-period">Last 30 days⌄</span></div>
 <div class="dash-stats">{[['AI tool spend','$18.4K','↑ 12%'],['Engineering value','$42K','↑ 28%'],['Value / cost','2.3x','↑ 0.4x'],['Change success','92%','↑ 8%']].map(s=><div><span>{s[0]}</span><strong>{s[1]}</strong><small>{s[2]}</small></div>)}</div>
 <div class="dash-charts"><div class="chart-panel"><h4>AI contribution over time</h4><p><i></i> AI assisted <i class="green-dot"></i> Human</p><div class="bar-chart">{bars.map((h)=><span style={`height:${h}%`}><i/></span>)}</div><div class="axis"><span>Oct 1</span><span>Oct 7</span><span>Oct 14</span><span>Oct 21</span><span>Oct 30</span></div></div><div class="chart-panel"><h4>Change risk distribution</h4><div class="donut-row"><div class="donut"><div><strong>324</strong><small>Changes</small></div></div><ul><li><i style="background:#ff5e6e"></i>High <b>8%</b></li><li><i style="background:#ffb24c"></i>Medium <b>22%</b></li><li><i></i>Low <b>45%</b></li><li><i style="background:#49607d"></i>No issues <b>25%</b></li></ul></div></div></div>
 <div class="dash-charts lower"><div class="chart-panel"><h4>Top AI-assisted areas</h4>{[['Code generation',82],['Tests & QA',60],['Documentation',42],['Refactoring',30]].map(([s,n])=><div class="horizontal-bar"><span>{s}</span><i><b style={`width:${n}%`}/></i></div>)}</div><div class="chart-panel"><h4>Quality trends</h4><svg class="line-chart" viewBox="0 0 300 80" role="img" aria-label="Illustrative quality trend"><path d="M0 20H300M0 45H300M0 70H300" stroke="#19344d"/><path d="m0 66 20-10 15 5 20-25 20 12 15-5 20 10 20-15 20 5 20-20 20 7 20-12 20 9 20-18 25 4" fill="none" stroke="#18b5ff" stroke-width="2.5"/><path d="m0 25 20-9 15 15 20-4 20 11 15-7 20 12 20-4 20 12 20-7 20 10 20-6 20 15 20-5 25 9" fill="none" stroke="#02d5aa" stroke-width="2"/></svg></div></div><p class="demo-caption">ILLUSTRATIVE PRODUCT DATA</p></div>
</div>
