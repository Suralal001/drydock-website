---
import Icon from './MarketingIcon.astro';
import '../styles/agent-studio.css';
const presets=[
{name:'Governance',icon:'shield',desc:'Check changes against team policies. Surface exceptions that need a decision.',owner:'Engineering lead',goal:'Detect payment-related AI changes',signals:['Git diff','Jira','AI provenance'],logic:'Payment code changed AND AI-assisted',action:'Route to senior reviewer',when:'A pull request opens'},
{name:'Quality',icon:'check',desc:'Inspect coverage and test results. Highlight gaps around changed code.',owner:'QA lead',goal:'Find untested changes before release',signals:['Git diff','Test results'],logic:'Changed code has missing tests OR coverage below policy',action:'Request a test review',when:'CI checks complete'},
{name:'Risk',icon:'search',desc:'Review the diff and flag changes that deserve closer attention.',owner:'Tech lead',goal:'Surface high-risk code changes',signals:['Git diff','Security scan'],logic:'Sensitive code changed OR blocking findings detected',action:'Route for risk assessment',when:'A pull request is updated'},
{name:'Delivery',icon:'layers',desc:'Bring release checks and blockers together before deployment.',owner:'Release manager',goal:'Identify unresolved release blockers',signals:['Test results','Approvals','Deployment'],logic:'Required checks failed OR approval is missing',action:'Hold release for review',when:'A release is proposed'},
{name:'Compliance',icon:'lock',desc:'Connect checks, approvals and overrides to an evidence trail.',owner:'Compliance owner',goal:'Find gaps in the decision record',signals:['Approvals','Jira','Security scan'],logic:'Required approval or supporting evidence is missing',action:'Request missing evidence',when:'A release record is updated'},
{name:'Productivity',icon:'chart',desc:'Look at review queues and delivery trends to identify bottlenecks.',owner:'Engineering manager',goal:'Identify review bottlenecks',signals:['Review history','Deployment'],logic:'Review wait time exceeds the team threshold',action:'Notify the engineering manager',when:'Delivery metrics refresh'}
];
---
<section class="agent-studio" id="crew"><div class="studio-wrap"><header class="studio-heading"><div><span>03 / SPECIALISED AI AGENTS</span><h2>A crew for the checks.<br/><em>Your team for the judgment.</em></h2></div><p>DryDock brings the findings together with a set of specialised AI agents. Use them as-is or create your own agent for the way your team works.</p></header><div class="studio-layout"><div class="studio-presets" aria-label="Agent presets">{presets.map((agent,i)=><button type="button" class:list={['studio-agent',{'selected':i===0}]} data-agent={i} aria-pressed={i===0}><Icon name={agent.icon} tone={['blue','green','purple','orange','blue','green'][i]}/><h3>{agent.name} agent</h3><p>{agent.desc}</p><span>Human owner → {agent.owner}</span></button>)}</div><aside class="studio-panel" id="byo" aria-label="Agent configuration"><div class="studio-panel-top"><span>✦</span><small id="studio-mode">PRESET / INSPECT & ADAPT</small></div><div id="studio-preview"><h3 id="studio-name">Governance agent</h3><p class="studio-intro">Inspect the signals and decisions behind this agent.</p><dl class="studio-config">{[['Goal',presets[0].goal],['Signals',presets[0].signals.join(' + ')],['Logic',presets[0].logic],['Action',presets[0].action],['Human owner',presets[0].owner]].map(([label,value],i)=><div><span>0{i+1}</span><div><dt>{label}</dt><dd data-config={i}>{value}</dd></div></div>)}</dl><button class="studio-primary" id="studio-create" type="button">Create your own agent <span>→</span></button><p class="studio-small">Start with this preset and adapt it to your policy.</p></div>
<form id="studio-builder" hidden><h3>Create your own agent.</h3><p class="studio-intro">Define the check. Keep a person responsible.</p><ol class="studio-progress">{['Goal','Signals','Logic','Action'].map((label,i)=><li data-builder-progress={i}>{label}</li>)}</ol><fieldset data-builder-step="0"><legend>01 / Define the goal</legend><label>Agent name<input id="agent-name" maxlength="45" required value="Payment review agent"/></label><label>What should it detect?<textarea id="agent-goal" maxlength="180" required rows="3"></textarea></label></fieldset><fieldset data-builder-step="1" hidden><legend>02 / Select the signals</legend><p>Select at least one source of evidence.</p><div class="studio-signals">{['Git diff','Jira','AI provenance','Test results','Security scan','Approvals','Deployment','Review history'].map(signal=><label><input type="checkbox" name="signal" value={signal}/>{signal}</label>)}</div></fieldset><fieldset data-builder-step="2" hidden><legend>03 / Define the logic</legend><label>When should the agent run?<input id="agent-when" maxlength="100" required/></label><label>Flag the change if…<textarea id="agent-logic" maxlength="200" required rows="3"></textarea></label></fieldset><fieldset data-builder-step="3" hidden><legend>04 / Choose the action</legend><label>What happens next?<input id="agent-action" maxlength="160" required/></label><label>Human owner<input id="agent-owner" maxlength="80" required/></label><p>A person owns the review and final decision.</p></fieldset><p id="studio-error" role="alert"></p><div class="studio-builder-actions"><button type="button" id="studio-back">Back</button><button type="submit" class="studio-primary" id="studio-next">Next: Signals →</button></div><button type="button" class="studio-cancel" id="studio-cancel">Cancel and return to preset</button></form><p class="studio-small">Interactive preview · agents created here are not deployed.</p></aside></div><div class="studio-rule" aria-live="polite"><div class="studio-rule-title"><span>YOUR WORKFLOW, YOUR POLICY</span><strong id="rule-name">Governance agent</strong></div><div><span>WHEN</span><p id="rule-when">A pull request opens</p></div><b>→</b><div><span>IF</span><p id="rule-if">Payment code changed AND AI-assisted</p></div><b>→</b><div><span>THEN</span><p id="rule-then">Route to senior reviewer</p><small id="rule-owner">Human owner: Engineering lead</small></div></div><p class="studio-status" id="studio-status" role="status"></p></div></section>
<script define:vars={{presets}}>
(()=>{
const root=document.querySelector('.agent-studio'),agents=[...presets];let selected=0,building=false,step=0,pinned=false;
const find=id=>root.querySelector('#'+id),form=find('studio-builder'),fields=['agent-name','agent-goal','agent-when','agent-logic','agent-action','agent-owner'];
function rule(agent){find('rule-name').textContent=agent.name.endsWith('agent')?agent.name:agent.name+' agent';find('rule-when').textContent=agent.when;find('rule-if').textContent=agent.logic;find('rule-then').textContent=agent.action;find('rule-owner').textContent='Human owner: '+agent.owner;}
function select(index){if(building)return;selected=index;const a=agents[index];root.querySelectorAll('[data-agent]').forEach(b=>{const active=Number(b.dataset.agent)===index;b.classList.toggle('selected',active);b.setAttribute('aria-pressed',String(active));});find('studio-name').textContent=a.name.endsWith('agent')?a.name:a.name+' agent';[a.goal,a.signals.join(' + '),a.logic,a.action,a.owner].forEach((v,i)=>root.querySelector('[data-config="'+i+'"]').textContent=v);find('studio-mode').textContent=index<6?'PRESET / INSPECT & ADAPT':'CUSTOM AGENT / PREVIEW';rule(a);}
const grid=root.querySelector('.studio-presets');grid.addEventListener('click',e=>{const b=e.target.closest('[data-agent]');if(b){pinned=true;select(Number(b.dataset.agent));}});grid.addEventListener('pointerover',e=>{if(pinned||!matchMedia('(hover: hover)').matches)return;const b=e.target.closest('[data-agent]');if(b&&!b.contains(e.relatedTarget))select(Number(b.dataset.agent));});grid.addEventListener('focusin',e=>{const b=e.target.closest('[data-agent]');if(b)select(Number(b.dataset.agent));});
function draft(){return{name:find('agent-name').value.trim(),goal:find('agent-goal').value.trim(),signals:[...form.querySelectorAll('[name="signal"]:checked')].map(x=>x.value),when:find('agent-when').value.trim(),logic:find('agent-logic').value.trim(),action:find('agent-action').value.trim(),owner:find('agent-owner').value.trim()};}
function showStep(){form.querySelectorAll('[data-builder-step]').forEach((f,i)=>{f.hidden=i!==step;f.disabled=i!==step;});root.querySelectorAll('[data-builder-progress]').forEach((li,i)=>{li.classList.toggle('current',i===step);li.setAttribute('aria-current',i===step?'step':'false');});find('studio-back').disabled=step===0;find('studio-next').textContent=['Next: Signals →','Next: Logic →','Next: Action →','Create preview agent →'][step];find('studio-error').textContent='';}
find('studio-create').addEventListener('click',()=>{building=true;step=0;const a=agents[selected];fields.forEach((id,i)=>find(id).value=[selected===0?'Payment review agent':a.name+' custom agent',a.goal,a.when,a.logic,a.action,a.owner][i]);form.querySelectorAll('[name="signal"]').forEach(c=>c.checked=a.signals.includes(c.value));find('studio-preview').hidden=true;form.hidden=false;find('studio-mode').textContent='CUSTOM AGENT / BUILDER';showStep();find('agent-name').focus();rule(draft());});
form.addEventListener('input',()=>rule(draft()));
function cancel(){building=false;form.hidden=true;find('studio-preview').hidden=false;select(selected);find('studio-create').focus();}
find('studio-cancel').addEventListener('click',cancel);find('studio-back').addEventListener('click',()=>{step--;showStep();form.querySelector('[data-builder-step="'+step+'"] input')?.focus();});
form.addEventListener('submit',e=>{e.preventDefault();const active=form.querySelector('[data-builder-step="'+step+'"]');if([...active.querySelectorAll('input[required],textarea[required]')].some(f=>!f.value.trim())){find('studio-error').textContent='Please complete each field before continuing.';return;}if(step===1&&!draft().signals.length){find('studio-error').textContent='Choose at least one signal.';return;}if(step<3){step++;showStep();form.querySelector('[data-builder-step="'+step+'"] input, [data-builder-step="'+step+'"] textarea')?.focus();return;}const a=draft();agents.push(a);const button=document.createElement('button');button.type='button';button.className='studio-agent studio-custom';button.dataset.agent=String(agents.length-1);const icon=document.createElement('span');icon.className='studio-custom-icon';icon.textContent='✦';const title=document.createElement('h3');title.textContent=a.name;const copy=document.createElement('p');copy.textContent=a.goal;const owner=document.createElement('span');owner.textContent='Human owner → '+a.owner;button.append(icon,title,copy,owner);grid.append(button);selected=agents.length-1;cancel();button.focus();find('studio-status').textContent=a.name+' created in this preview. Your configuration is shown below; no live agent has been deployed.';});
select(0);
})();
</script>
