---
import Icon from './MarketingIcon.astro';
import '../styles/release-record.css';
const stages=[['Intent','Jira PAY-482','layers'],['Change','PR #1291','code'],['Verify','41 / 41 checks','shield'],['Policy','PAY-07','bolt'],['Approve','Sarah M.','users'],['Release','4.2','chart']];
---
<section class="release-section" id="how-it-works">
<div class="release-wrap"><header class="release-heading"><div><span class="release-eyebrow">02 / ONE RELEASE. ONE RECORD.</span><h2>From intent to production.<br/><em>A complete, explainable record.</em></h2></div><p>DryDock connects the signals across your delivery stack and turns them into a single, defensible release record — what changed, how it was verified, who approved it, and what happened after shipping.</p></header>
<div class="record-shell"><aside class="record-sidebar"><div class="record-identity"><img src="/github.svg" width="32" height="32" alt="GitHub"/><div><strong>PR #1291</strong><p>Payment reconciliation update</p><span>✓ Released</span></div></div><div class="record-nav" aria-label="Release record contents"><div class="selected"><Icon name="layers"/>Release story</div><div><Icon name="code"/>Evidence</div><div><Icon name="shield"/>Policy & approval</div><div><Icon name="chart"/>Production outcome</div></div><small>ILLUSTRATIVE RELEASE RECORD</small></aside>
<div class="record-workspace"><div class="record-stages" role="group" aria-label="Investigate a release stage"><div class="evidence-path" aria-hidden="true"><i></i></div>{stages.map(([name,detail,icon],i)=><button type="button" data-record-stage={i} aria-pressed={i===3} aria-controls="release-stage-panel" class:list={{'selected':i===3,'policy-stage':i===3}}><span class="record-stage-icon"><Icon name={icon}/>{i!==3&&<b>✓</b>}</span><strong>{name}</strong><small>{detail}</small></button>)}</div>
<div class="record-panels"><article class="record-story" id="release-stage-panel" aria-live="polite" aria-atomic="true"><span id="release-kicker">POLICY EXCEPTION</span><h3 id="release-title">PAY-07 triggered</h3><h4 id="release-subtitle">Payment changes require senior review.</h4><p id="release-copy">This change modifies payment reconciliation logic. Automated checks passed, but human approval was required before production.</p><div class="record-tags" id="release-tags"><span>✓ Tests</span><span>✓ Security</span><span>✓ Requirement</span><span>✓ Diff</span></div></article>
<article class="record-facts" aria-label="Stage evidence" aria-live="polite"><div><Icon name="layers"/><p><b id="fact-label-0">Policy</b><span id="fact-value-0">PAY-07 · Payment code</span></p></div><div><Icon name="code"/><p><b id="fact-label-1">Triggered because</b><span id="fact-value-1">payments/reconciliation.ts changed</span></p></div><div><Icon name="users"/><p><b id="fact-label-2">Decision owner</b><span id="fact-value-2">Sarah M. · Tech Lead</span></p></div><div><Icon name="check"/><p><b id="fact-label-3">Decision</b><span id="fact-value-3">✓ Approved after review</span></p></div><div><Icon name="clock"/><p><b id="fact-label-4">Timestamp</b><span id="fact-value-4">Oct 14, 2026 · 16:31 UTC</span></p></div></article>
<article class="record-outcome" aria-live="polite"><header><Icon name="chart"/><h3>Production<br/>outcome</h3><span id="outcome-badge">Linked</span></header><div class="outcome-wait"><Icon name="shield"/><h4>The story continues in production.</h4><p>Select Release to trace this decision to its observed outcome.</p><span>Release 4.2 → Production</span></div><div class="outcome-results" hidden><div><Icon name="clock"/><p><b>14 days</b><span>observed</span></p></div><div><Icon name="shield"/><p><b>0</b><span>linked incidents</span></p></div><div><Icon name="layers"/><p><b>0</b><span>rollbacks</span></p></div><svg viewBox="0 0 280 85" aria-label="Stable observed production trend" role="img"><path d="M0 80Q30 75 60 59T105 48T150 34T195 32T240 18L280 2V85H0Z" fill="#ccf5e7"/><path d="M0 80Q30 75 60 59T105 48T150 34T195 32T240 18L280 2" fill="none" stroke="#42cfa0" stroke-width="2"/></svg></div></article></div></div></div>
<div class="record-benefits">{[['layers','Connected evidence','From ticket to production, without gaps.'],['shield','Human accountability','The right review, with full context.'],['chart','Proven outcome','Validate that the change was stable after release.']].map(([icon,title,copy])=><div><Icon name={icon}/><p><strong>{title}</strong><span>{copy}</span></p></div>)}</div></div></section>
<script>
const root=document.querySelector<HTMLElement>('.release-section')!;
const records=[
{label:'ORIGINAL INTENT',title:'A requirement with context',sub:'Reconcile partial refunds accurately.',copy:'PAY-482 defines the expected payment behavior and acceptance criteria. The original requirement stays linked to the change and its release.',tags:['PAY-482','Acceptance criteria','Owner'],facts:[['Requirement','PAY-482 · Payment reconciliation'],['Expected behavior','Handle partial refunds accurately'],['Owner','Payments team'],['Linked change','PR #1291'],['Traceability','Ticket → change → release 4.2']]},
{label:'CODE CHANGE',title:'PR #1291',sub:'Update payment reconciliation.',copy:'Three files changed to improve payment matching and handle partial refunds. The diff is connected to the requirement and every downstream check.',tags:['3 files','+142 / −28','Linked intent'],facts:[['Repository','payments-service'],['Branch','feature/payment-reconcile'],['Files changed','3 files · reconciliation logic'],['Linked intent','PAY-482'],['Release','4.2']]},
{label:'AUTOMATED VERIFICATION',title:'41 of 41 checks passed',sub:'Verified code. A separate approval decision.',copy:'Unit, integration and security checks completed. Passing automation supplies evidence; it does not replace the senior review required for payment changes.',tags:['Tests passed','92% coverage','Security checked'],facts:[['Test results','41 / 41 checks passed'],['Coverage','92%'],['Security','No blocking findings'],['Artifacts','CI results attached'],['Next requirement','PAY-07 · Senior review']]},
{label:'POLICY EXCEPTION',title:'PAY-07 triggered',sub:'Payment changes require senior review.',copy:'This change modifies payment reconciliation logic. Automated checks passed, but human approval was required before production.',tags:['Tests','Security','Requirement','Diff'],facts:[['Policy','PAY-07 · Payment code'],['Triggered because','payments/reconciliation.ts changed'],['Decision owner','Sarah M. · Tech Lead'],['Decision','✓ Approved after review'],['Timestamp','Oct 14, 2026 · 16:31 UTC']]},
{label:'HUMAN APPROVAL',title:'A decision with an owner',sub:'Sarah M. approved with full context.',copy:'The tech lead reviewed the code diff, test results and policy requirement. The approval and its supporting evidence remain attached to the release record.',tags:['Identity recorded','Evidence linked','Timestamped'],facts:[['Approver','Sarah M. · Tech Lead'],['Decision','Approved'],['Reviewed evidence','Diff, tests, security and PAY-482'],['Policy satisfied','PAY-07 · Senior review'],['Recorded at','Oct 14, 2026 · 16:31 UTC']]},
{label:'PRODUCTION RESULT',title:'Released. Observed. Stable.',sub:'Release 4.2 closes the evidence chain.',copy:'Fourteen days of production observation are linked back to the original intent. No incidents or rollbacks were recorded for this illustrative release.',tags:['14 days observed','0 incidents','0 rollbacks'],facts:[['Release','4.2 · Production'],['Approval','Sarah M. · Recorded before deployment'],['Observation window','Oct 14–28, 2026'],['Linked incidents','0'],['Final outcome','Stable']]}
];
const buttons=Array.from(root.querySelectorAll<HTMLButtonElement>('[data-record-stage]'));
function select(index:number){const record=records[index];buttons.forEach((button,i)=>{button.classList.toggle('selected',i===index);button.setAttribute('aria-pressed',String(i===index));});for(const [id,value] of Object.entries({'release-kicker':record.label,'release-title':record.title,'release-subtitle':record.sub,'release-copy':record.copy}))root.querySelector('#'+id)!.textContent=value;root.querySelector('#release-tags')!.replaceChildren(...record.tags.map(tag=>{const span=document.createElement('span');span.textContent='✓ '+tag;return span;}));record.facts.forEach(([label,value],i)=>{root.querySelector('#fact-label-'+i)!.textContent=label;root.querySelector('#fact-value-'+i)!.textContent=value;});const released=index===5;root.querySelector<HTMLElement>('.outcome-wait')!.hidden=released;root.querySelector<HTMLElement>('.outcome-results')!.hidden=!released;root.querySelector('#outcome-badge')!.textContent=released?'✓ Stable':'Linked';root.querySelector('.record-outcome')!.classList.toggle('is-released',released);root.querySelector('.record-story')!.classList.toggle('policy-story',index===3);}
buttons.forEach((button,i)=>button.addEventListener('click',()=>select(i)));
select(3);
const observer=new IntersectionObserver(entries=>{if(entries.some(entry=>entry.isIntersecting)){root.classList.add('evidence-assembled');observer.disconnect();}},{threshold:.25});observer.observe(root.querySelector('.record-shell')!);
</script>
